<%= render "cabecalho", titulo: "Novo funcionário",
                        subtitulo: "Cadastre um funcionário do RU e escolha se ele também será administrador." %>

<div class="grade-cadastro">
  <section class="cartao" aria-labelledby="titulo-formulario">
    <header class="cartao__cabecalho">
      <h2 class="cartao__titulo" id="titulo-formulario">Dados do funcionário</h2>
      <span class="selo">Todos os campos são obrigatórios</span>
    </header>

    <%= form_with model: @cadastro, url: controle_funcionarios_path, class: "formulario", html: { novalidate: true } do |f| %>
      <% if @cadastro.errors.any? %>
        <div class="alerta alerta--erro" role="alert">
          <%= icone :alerta, classe: "alerta__icone" %>
          <div>
            <p class="alerta__titulo">Não foi possível cadastrar o funcionário</p>
            <p class="alerta__texto">Corrija os campos destacados e tente novamente.</p>
          </div>
        </div>
      <% end %>

      <fieldset class="formulario__grupo">
        <legend class="rotulo-secao">Identificação</legend>

        <%= render "shared/campo", form: f, atributo: :nome, rotulo: "Nome completo", simbolo: :usuario,
                                   opcoes: { autocomplete: "off", placeholder: "Ex.: José Pereira" } %>

        <div class="formulario__linha">
          <%= render "shared/campo", form: f, atributo: :siape, rotulo: "SIAPE", simbolo: :matricula,
                                     dica: "#{Funcionario::TAMANHO_DO_SIAPE} dígitos. Ex.: 1234567",
                                     opcoes: { inputmode: "numeric", autocomplete: "off", placeholder: "1234567" } %>

          <%= render "shared/campo", form: f, atributo: :email, rotulo: "E-mail", simbolo: :email, tipo: :email_field,
                                     opcoes: { autocomplete: "off", placeholder: "funcionario@unb.br" } %>
        </div>
      </fieldset>

      <fieldset class="formulario__grupo">
        <legend class="rotulo-secao">Senha inicial</legend>

        <div class="formulario__linha">
          <%= render "shared/campo", form: f, atributo: :senha, rotulo: "Senha", simbolo: :cadeado, tipo: :password_field,
                                     dica: "Mínimo de #{Usuario::TAMANHO_MINIMO_SENHA} caracteres",
                                     opcoes: { autocomplete: "new-password" } %>

          <%= render "shared/campo", form: f, atributo: :confirmacao_senha, rotulo: "Confirmação de senha",
                                     simbolo: :cadeado, tipo: :password_field, dica: "Repita a senha escolhida",
                                     opcoes: { autocomplete: "new-password" } %>
        </div>
      </fieldset>

      <fieldset class="formulario__grupo">
        <legend class="rotulo-secao">Perfil de acesso</legend>

        <div class="campo">
          <div class="segmentos">
            <% { false => "Funcionário", true => "Administrador" }.each do |valor, rotulo| %>
              <label class="segmentos__item">
                <%= f.radio_button :administrador, valor, class: "segmentos__opcao",
                                   aria: { describedby: "cadastro_funcionario_administrador_dica" } %>
                <%= rotulo %>
              </label>
            <% end %>
          </div>
          <p class="campo__dica" id="cadastro_funcionario_administrador_dica">
            O administrador também gerencia restaurantes, catracas e funcionários e vê o relatório global.
          </p>
        </div>
      </fieldset>

      <div class="formulario__acoes">
        <%= link_to "Cancelar", controle_funcionarios_path, class: "botao botao--secundario" %>
        <%= f.button type: "submit", class: "botao botao--primario" do %>
          <%= icone :confirmar %> Cadastrar funcionário
        <% end %>
      </div>
    <% end %>
  </section>

  <aside class="coluna-lateral">
    <section class="cartao" aria-labelledby="titulo-regras">
      <h2 class="cartao__titulo" id="titulo-regras">Regras do cadastro</h2>
      <ul class="lista-regras">
        <li><%= icone :confirmar %> SIAPE com exatamente <%= Funcionario::TAMANHO_DO_SIAPE %> dígitos numéricos</li>
        <li><%= icone :confirmar %> Cada SIAPE e cada e-mail podem ser cadastrados uma única vez</li>
        <li><%= icone :confirmar %> Nome, e-mail e senha são obrigatórios</li>
        <li><%= icone :confirmar %> Senha com no mínimo <%= Usuario::TAMANHO_MINIMO_SENHA %> caracteres, igual à confirmação</li>
      </ul>
    </section>

    <section class="cartao" aria-labelledby="titulo-perfis">
      <h2 class="cartao__titulo" id="titulo-perfis">Perfis de acesso</h2>
      <ul class="lista-regras">
        <li><%= icone :entrar %> <span><strong>Funcionário:</strong> escolhe o ponto de acesso, opera a catraca e vê o histórico dela</span></li>
        <li><%= icone :escudo %> <span><strong>Administrador:</strong> tudo o que o funcionário faz, e também gerencia restaurantes, catracas e funcionários</span></li>
      </ul>
    </section>
  </aside>
</div>
